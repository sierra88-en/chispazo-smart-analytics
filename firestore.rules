rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net (default-deny catch-all)
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    
    function incoming() { 
      return request.resource.data; 
    }
    
    function existing() { 
      return resource.data; 
    }

    // Validation Blueprint for Draw
    function isValidDraw(data) {
      return data.keys().hasAll(['CONCURSO', 'FECHA', 'R1', 'R2', 'R3', 'R4', 'R5']) 
        && data.keys().size() >= 7
        && data.CONCURSO is int
        && data.FECHA is string
        && data.R1 is int && data.R1 >= 1 && data.R1 <= 28
        && data.R2 is int && data.R2 >= 1 && data.R2 <= 28
        && data.R3 is int && data.R3 >= 1 && data.R3 <= 28
        && data.R4 is int && data.R4 >= 1 && data.R4 <= 28
        && data.R5 is int && data.R5 >= 1 && data.R5 <= 28;
    }

    // Validation Blueprint for WeightSettings
    function isValidWeightSettings(data) {
      return data.keys().hasAll(['weights'])
        && data.weights is map;
    }

    // Validation Blueprint for SuitcaseHistoryEntry
    function isValidSuitcase(data) {
      return data.keys().hasAll(['draw', 'date', 'weight_28', 'result'])
        && data.draw is int
        && data.date is string
        && data.weight_28 is number
        && data.result is list;
    }

    // Draws Collection rules
    match /draws/{concursoId} {
      allow read, write: if true;
    }

    // Settings Collection rules
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Suitcase History Collection rules
    match /suitcaseHistory/{drawId} {
      allow read, write: if true;
    }
  }
}
